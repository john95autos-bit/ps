# =============================================================================
#  HomeGuard Services — Apache configuration
#  Works unchanged whether the site sits at htdocs/ps2 or at a domain root.
#  Every directive is wrapped in <IfModule> so a missing module degrades
#  gracefully instead of returning a 500.
# =============================================================================

DirectoryIndex index.php
Options -Indexes -MultiViews

AddDefaultCharset UTF-8

# -----------------------------------------------------------------------------
#  Rewriting.
#
#  ORDER IS LOAD-BEARING. The deny rules must come before the "file exists"
#  passthrough: that rule ends the ruleset with [L] for every request that maps
#  to a real file on disk, which is exactly the case the deny rules exist to
#  cover. With the denies placed after it, every .php file under config/, inc/,
#  partials/ and views/ was directly executable over HTTP.
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Application source is never served. `_legacy-nextjs` no longer exists
    #    (the retired Next.js source was deleted); the name is kept here so a
    #    restored backup could not expose it.
    RewriteRule ^(config|inc|partials|views|storage|_legacy-nextjs)(/|$) - [F,L]

    # 2. No dot-directories or dotfiles at any depth (.git, .openai, .jetro,
    #    .sites-runtime and friends). <FilesMatch> only tests the basename, so
    #    it cannot cover a file nested inside a dot-directory; this can.
    #    .well-known stays reachable for ACME/TLS validation.
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # 3. Real files and directories are served as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. Everything else is a route: hand it to the front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# -----------------------------------------------------------------------------
#  Defence in depth, for the case where mod_rewrite is unavailable.
# -----------------------------------------------------------------------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "\.(md|json|jsonl|csv|lock|ts|tsx|mjs|sh|log|example|bak|sql|yml|yaml|ini)$">
    Require all denied
</FilesMatch>

# index.php must stay reachable — it is the front controller.
<Files "index.php">
    Require all granted
</Files>

# -----------------------------------------------------------------------------
#  Security headers. These are the single owner: index.php deliberately does not
#  re-send them, so responses carry exactly one of each.
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Stop advertising the exact PHP patch version to every scanner.
    Header always unset X-Powered-By
    Header always unset Server

    # HSTS, but only on a response that actually arrived over TLS — sending it
    # over plain HTTP is meaningless, and sending it from localhost would pin
    # the developer's browser to HTTPS for all of localhost.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# -----------------------------------------------------------------------------
#  HTTPS. site_url, canonical, og:url and every sitemap <loc> assert https, so
#  the server must actually deliver it. Localhost and 127.0.0.1 are exempt so
#  local development over plain HTTP keeps working.
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# -----------------------------------------------------------------------------
#  Compression
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml application/ld+json
    # woff2 is already compressed; re-compressing it wastes CPU for nothing.
</IfModule>

# -----------------------------------------------------------------------------
#  Caching. Assets are requested with an ?v=<mtime> cache-buster, so they can be
#  cached hard; HTML must not be.
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 hour"
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|svg|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/svg+xml .svg
</IfModule>
