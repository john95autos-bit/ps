{
  "name": "ad-housing-services",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-seo.js && vite build && vite build --ssr scripts/prerender.jsx --outDir .prerender --logLevel error && node .prerender/prerender.js",
    "preview": "vite preview",
    "seo": "node scripts/generate-seo.js",
    "smoke": "vite build --ssr scripts/smoke.jsx --outDir .smoke --logLevel error && node .smoke/smoke.js",
    "prerender": "vite build --ssr scripts/prerender.jsx --outDir .prerender --logLevel error && node .prerender/prerender.js"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
