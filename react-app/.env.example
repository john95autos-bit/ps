# Copy to .env.local for local development. On Vercel, set these under
# Settings > Environment Variables instead.
#
# VITE_* values are compiled into the browser bundle and are PUBLIC.
# Everything below the divider is server-only and never reaches the client.

# --- Public (browser) -------------------------------------------------------

# The final HTTPS domain, no trailing slash. Drives canonical tags, Open Graph
# URLs, robots.txt and sitemap.xml. While this is the placeholder, robots.txt is
# generated with "Disallow: /" so a preview deployment cannot be crawled.
VITE_SITE_URL=https://www.yourdomain.com

# Call-conversion tracking. Use ONE of the two setups.
#
# A) gtag.js — both values. The label comes from the Google Ads conversion
#    action screen ("Tag setup > Install the tag yourself") and is the part
#    AFTER the slash in send_to: 'AW-123456789/AbC-D_efGh12345'.
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_CONVERSION_LABEL=
#
# B) Google Tag Manager — set this instead and build the trigger in GTM off the
#    `phone_click` dataLayer event.
VITE_GTM_ID=

# The launch switch. While this is anything but "true" the site sends
# `noindex, nofollow` and shows a pre-launch banner on every page. Set it to
# true only once every item in LAUNCH-CHECKLIST.md is done — and note that the
# app re-checks: if it can still find placeholder details, it stays noindex and
# tells you which ones on the banner.
VITE_CONFIGURED=false

# --- Server-only (api/lead.js) ----------------------------------------------

# Where enquiries go. Configure at least one channel, or the form returns a
# "not connected yet" message rather than pretending a dropped lead was sent.

# Email via Resend (https://resend.com). LEAD_FROM_EMAIL must be on a domain you
# have verified with Resend; LEAD_EMAIL is where you want the enquiry to land.
RESEND_API_KEY=
LEAD_FROM_EMAIL=website@yourdomain.com
LEAD_EMAIL=support@adhousingservices.com

# Or POST the lead as JSON to a URL you control (Zapier, n8n, your CRM).
# Can be used on its own or alongside email.
LEAD_WEBHOOK_URL=
